{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/schemas/common/v1/common.schema.json",
  "title": "F-02 common bounded records",
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "documentId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "issuer": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_set_digest", "document_id", "issuer", "issued_at", "expires_at"],
      "properties": {
        "schema": {"type": "string"},
        "schema_set_digest": {"$ref": "#/$defs/digest"},
        "document_id": {"$ref": "#/$defs/documentId"},
        "issuer": {"$ref": "#/$defs/issuer"},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
