            },
            "issuer": {
              "$ref": "../../common/v1/common.schema.json#/$defs/issuer"
            },
            "issued_at": {
              "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
            },
            "expires_at": {
              "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
            },
            "registry_revision": {},
            "boards": {},
            "capability_vocabulary": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "schema_set_digest",
            "document_id",
            "issuer",
            "issued_at",
            "expires_at",
            "channel",
            "release_version",
            "board_registry_digest",
            "board_targets",
            "board_identities",
            "qualification_bindings",
            "components",
