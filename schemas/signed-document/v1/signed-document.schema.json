              "$ref": "../../common/v1/common.schema.json#/$defs/digest"
            },
            "document_id": {
              "$ref": "../../common/v1/common.schema.json#/$defs/documentId"
            },
            "issuer": {
              "$ref": "../../common/v1/common.schema.json#/$defs/issuer"
            },
            "issued_at": {
              "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
            },
            "expires_at": {
              "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
            },
            "channel": {},
            "release_version": {},
            "board_registry_digest": {},
            "board_targets": {},
            "board_identities": {},
            "qualification_bindings": {},
            "components": {},
            "artifacts": {},
            "artifact_set_digest": {},
            "allowed_mutations": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "schema_set_digest",
            "document_id",
            "issuer",
            "issued_at",
            "expires_at",
            "selection",
