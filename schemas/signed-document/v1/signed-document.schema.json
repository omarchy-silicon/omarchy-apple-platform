{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/schemas/signed-document/v1/signed-document.schema.json",
  "title": "F-02 signed envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "payload_type",
    "payload_version",
    "domain",
    "context",
    "schema_set_digest",
    "payload",
    "signatures"
  ],
  "properties": {
    "format": {
      "const": "omarchy-signed/v1"
    },
    "payload_type": {
      "enum": [
        "board-registry/v1",
        "platform-manifest/v1",
        "installer-plan/v1",
        "qualification-record/v1",
        "boot-health/v1",
        "owner-approval/v1",
        "boot-success-mark/v1",
        "dtb-mutation-envelope/v1"
      ]
    },
    "payload_version": {
      "const": "v1"
    },
    "domain": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "schema_set_digest": {
      "$ref": "../../common/v1/common.schema.json#/$defs/digest"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "schema_set_digest",
            "document_id",
            "issuer",
            "issued_at",
            "expires_at",
            "registry_revision",
            "boards",
            "capability_vocabulary"
          ],
          "properties": {
            "schema": {
              "const": "board-registry/v1"
            },
            "schema_set_digest": {
              "$ref": "../../common/v1/common.schema.json#/$defs/digest"
            },
            "document_id": {
