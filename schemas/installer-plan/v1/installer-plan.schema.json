{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/schemas/installer-plan/v1/installer-plan.schema.json",
  "title": "F-02 installer-plan/v1 payload",
  "allOf": [
    {
      "$ref": "../../common/v1/common.schema.json#/$defs/payload"
    },
    {
      "type": "object",
      "required": [
        "schema",
        "schema_set_digest",
        "document_id",
        "issuer",
        "issued_at",
        "expires_at",
        "selection",
        "artifacts",
        "mutations"
      ],
      "properties": {
        "schema": {
          "const": "installer-plan/v1"
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mutation"
          }
        },
        "schema_set_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        },
        "document_id": {
          "$ref": "../../common/v1/common.schema.json#/$defs/documentId"
        },
        "issuer": {
          "$ref": "../../common/v1/common.schema.json#/$defs/issuer"
        },
        "issued_at": {
          "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_id",
        "board_registry_digest",
        "manifest_id",
        "manifest_digest",
        "schema_set_digest"
      ],
      "properties": {
        "board_id": {
          "type": "string",
          "pattern": "^apple:[a-z0-9][a-z0-9-]{0,63}$"
        },
        "board_registry_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        },
        "manifest_id": {
          "$ref": "../../common/v1/common.schema.json#/$defs/documentId"
        },
        "manifest_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        },
        "schema_set_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_digest"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact:[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "content_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation",
        "target_id",
        "expected_digest"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "operation": {
          "enum": [
            "inspect/v1",
            "write/v1",
            "replace/v1",
            "remove/v1",
            "rollback/v1"
          ]
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "expected_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        }
      }
    }
  }
}
