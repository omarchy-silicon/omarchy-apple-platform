{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/schemas/qualification-record/v1/qualification-record.schema.json",
  "title": "F-02 qualification-record/v1 payload",
  "allOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "schema_set_digest",
        "document_id",
        "issuer",
        "issued_at",
        "expires_at",
        "board_id",
        "manifest_id",
        "manifest_digest",
        "qualification_profile_id",
        "checks",
        "evidence",
        "outcome",
        "evidence_set_digest"
      ],
      "properties": {
        "schema": {
          "const": "qualification-record/v1"
        },
        "board_id": {
          "type": "string",
          "pattern": "^apple:[a-z0-9][a-z0-9-]{0,63}$"
        },
        "manifest_id": {
          "$ref": "../../common/v1/common.schema.json#/$defs/documentId"
        },
        "manifest_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        },
        "qualification_profile_id": {
          "type": "string",
          "pattern": "^profile:[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          },
          "maxItems": 1024,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 1024,
          "uniqueItems": true
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "blocked"
          ]
        },
        "schema_set_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        },
        "document_id": {
          "$ref": "../../common/v1/common.schema.json#/$defs/documentId"
        },
        "issuer": {
          "$ref": "../../common/v1/common.schema.json#/$defs/issuer"
        },
        "issued_at": {
          "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "../../common/v1/common.schema.json#/$defs/timestamp"
        },
        "evidence_set_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "required",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^check:[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not-run",
            "blocked"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evidence:[a-z0-9][a-z0-9._:-]{0,127}$"
          },
          "maxItems": 1024
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "content_digest",
        "physical",
        "locator"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^evidence:[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "content_digest": {
          "$ref": "../../common/v1/common.schema.json#/$defs/digest"
        },
        "physical": {
          "type": "boolean"
        },
        "locator": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,256}$"
        }
      }
    }
  }
}
