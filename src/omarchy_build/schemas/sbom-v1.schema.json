{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/f04/sbom/v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "artifact_set_digest", "entries", "sbom_digest"],
  "properties": {
    "version": {"const": "sbom/v1"}, "artifact_set_digest": {"$ref": "#/$defs/digest"}, "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}, "sbom_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry": {"type": "object", "additionalProperties": false, "required": ["output_path", "component_id", "version", "digest", "dependencies", "notice_ref"], "properties": {"output_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"}, "component_id": {"type": "string", "pattern": "^artifact:[a-z0-9][a-z0-9._:-]{0,127}$"}, "version": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "notice_ref": {"$ref": "#/$defs/digest"}}}
  }
}
