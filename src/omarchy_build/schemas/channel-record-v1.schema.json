{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/f04/channel-record/v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "channel", "release_id", "index_digest", "artifact_set_digest", "rollback_artifact_digests", "record_digest"],
  "properties": {
    "version": {"const": "channel-record/v1"}, "channel": {"enum": ["edge", "rc", "stable"]}, "release_id": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._:-]+$"}, "index_digest": {"$ref": "#/$defs/digest"}, "artifact_set_digest": {"$ref": "#/$defs/digest"}, "rollback_artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "record_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
