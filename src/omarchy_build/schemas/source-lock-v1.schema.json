{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/f04/source-lock/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recipe_id", "recipe_digest", "inputs", "closure_digest"],
  "properties": {
    "version": {"const": "source-lock/v1"},
    "recipe_id": {"type": "string", "pattern": "^recipe:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "recipe_digest": {"$ref": "#/$defs/digest"},
    "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/input"}},
    "closure_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["input_id", "kind", "uri", "commit", "digest", "media_type", "relative_path"],
      "properties": {
        "input_id": {"type": "string", "pattern": "^input:[a-z0-9][a-z0-9._:-]{0,127}$"},
        "kind": {"enum": ["source", "toolchain", "recipe", "generated", "opaque-boot-envelope"]},
        "uri": {"type": "string", "pattern": "^https://[^/?#]+/[^?#]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "digest": {"$ref": "#/$defs/digest"},
        "media_type": {"enum": ["application/octet-stream", "application/x-tar", "application/gzip", "application/json"]},
        "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"}
      }
    }
  }
}
