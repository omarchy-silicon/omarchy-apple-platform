{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/f04/build-provenance/v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "builder_id", "builder_definition_digest", "recipe_digest", "source_closure_digest", "toolchain_digest", "environment_digest", "artifact_set_digest", "input_digests", "sbom_digest", "log_digest", "provenance_digest"],
  "properties": {
    "version": {"const": "build-provenance/v1"}, "builder_id": {"type": "string", "pattern": "^builder:[a-z0-9][a-z0-9._:-]{0,127}$"}, "builder_definition_digest": {"$ref": "#/$defs/digest"}, "recipe_digest": {"$ref": "#/$defs/digest"}, "source_closure_digest": {"$ref": "#/$defs/digest"}, "toolchain_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"}, "artifact_set_digest": {"$ref": "#/$defs/digest"}, "input_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "sbom_digest": {"$ref": "#/$defs/digest"}, "log_digest": {"$ref": "#/$defs/digest"}, "provenance_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
