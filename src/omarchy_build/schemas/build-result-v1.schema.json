{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/f04/build-result/v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "builder_id", "builder_definition_digest", "recipe_id", "recipe_digest", "source_closure_digest", "toolchain_digest", "environment_digest", "outputs", "artifact_set_digest", "provenance_digest", "sbom_digest", "result_digest"],
  "properties": {
    "version": {"const": "build-result/v1"}, "builder_id": {"type": "string", "pattern": "^builder:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "builder_definition_digest": {"$ref": "#/$defs/digest"}, "recipe_id": {"type": "string", "pattern": "^recipe:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "recipe_digest": {"$ref": "#/$defs/digest"}, "source_closure_digest": {"$ref": "#/$defs/digest"}, "toolchain_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/output"}}, "artifact_set_digest": {"$ref": "#/$defs/digest"}, "provenance_digest": {"$ref": "#/$defs/digest"}, "sbom_digest": {"$ref": "#/$defs/digest"}, "result_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output": {"type": "object", "additionalProperties": false, "required": ["path", "media_type", "byte_count", "content_digest"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"}, "media_type": {"enum": ["application/octet-stream", "application/x-tar", "application/gzip", "application/json"]}, "byte_count": {"type": "integer", "minimum": 0}, "content_digest": {"$ref": "#/$defs/digest"}}}
  }
}
