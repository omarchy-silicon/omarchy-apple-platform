{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/f04/package-index/v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "release_id", "channel", "platform_manifest_id", "platform_manifest_digest", "schema_set_digest", "artifacts", "artifact_set_digest", "rollback_artifact_digests", "index_digest"],
  "properties": {
    "version": {"const": "package-index/v1"}, "release_id": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$"}, "channel": {"enum": ["edge", "rc", "stable"]}, "platform_manifest_id": {"type": "string", "minLength": 1}, "platform_manifest_digest": {"$ref": "#/$defs/digest"}, "schema_set_digest": {"$ref": "#/$defs/digest"}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}, "artifact_set_digest": {"$ref": "#/$defs/digest"}, "rollback_artifact_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "index_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "artifact_class", "content_digest", "build_result_digests", "provenance_digest", "sbom_digest"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact:[a-z0-9][a-z0-9._:-]{0,127}$"}, "artifact_class": {"enum": ["bootloader", "kernel", "firmware", "device-tree", "mesa", "userspace-package", "release-index"]}, "content_digest": {"$ref": "#/$defs/digest"}, "build_result_digests": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "provenance_digest": {"$ref": "#/$defs/digest"}, "sbom_digest": {"$ref": "#/$defs/digest"}}}
  }
}
