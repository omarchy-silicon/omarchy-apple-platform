{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/f04/fixture-recipe/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recipe_id", "input_ids", "read_paths", "output_path", "output_media_type", "prefix", "recipe_digest"],
  "properties": {
    "version": {"const": "fixture-recipe/v1"},
    "recipe_id": {"type": "string", "pattern": "^recipe:[a-z0-9][a-z0-9._:-]{0,127}$"},
    "input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^input:[a-z0-9][a-z0-9._:-]{0,127}$"}},
    "read_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"}},
    "output_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[^\\\\]+$"},
    "output_media_type": {"enum": ["application/octet-stream", "application/x-tar", "application/gzip", "application/json"]},
    "prefix": {"type": "string", "minLength": 1},
    "recipe_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
