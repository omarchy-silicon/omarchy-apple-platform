{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/q01/board-inventory-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_set_digest", "inventory_id", "revision", "boards"],
  "properties": {
    "schema": {"const": "qualification-board-inventory/v1"},
    "schema_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "inventory_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "boards": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/board"}}
  },
  "$defs": {
    "board": {
      "type": "object", "additionalProperties": false,
      "required": ["board_id", "selector", "profile_ids", "capabilities"],
      "properties": {
        "board_id": {"type": "string", "pattern": "^apple:[a-z0-9][a-z0-9-]{0,63}$"},
        "selector": {"enum": ["j313"]},
        "profile_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^profile:[a-z0-9][a-z0-9._:-]{0,127}$"}},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/criterion"}}
      }
    },
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["capability_id", "applicability", "evidence_modality", "threshold"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "applicability": {"enum": ["applicable", "not-applicable", "unknown"]},
        "evidence_modality": {"enum": ["automated", "human-observed", "automated-and-human"]},
        "threshold": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
