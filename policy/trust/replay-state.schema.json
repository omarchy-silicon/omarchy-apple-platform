{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchy.local/policy/trust/replay-state/v1",
  "title": "F-03 bounded replay state",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "format", "version"],
  "properties": {
    "entries": {"type": "array", "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["scope", "sequence", "version", "metadata_digest", "lineage_digest"], "properties": {"scope": {"type": "string", "minLength": 1, "maxLength": 4096}, "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "version": {"type": "string", "maxLength": 4096}, "metadata_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "lineage_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}},
    "format": {"const": "omarchy-replay-state/v1"},
    "version": {"const": "v1"}
  }
}
